#!/bin/bash
set -euo pipefail
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
if (( $# == 0 )) || [[ "$1" == "--help" ]]; then
  cat <<'HELP'
Usage: bash bin/wgrc COMMAND [ARGS]
User commands (Node.js; no relayer binary required):
  deposit AMOUNT_GRC --solana-address ADDRESS
  broadcast-deposit DEPOSIT_JSON_FILE   Retry the same saved transaction
  withdraw AMOUNT_WGRC --gridcoin-address ADDRESS [--nonce NONCE]
  status
  supply [--pending-deposits] [--pending-payouts]
    --pending-payouts requires the relayer binary and database access
Bridge operator commands (compiled Rust relayer required):
  serve START_HEIGHT [--once] [--enable-payouts]
  watch-gridcoin START_HEIGHT [--once] [--mint] [--max-blocks N]
  watch-solana [--once]
  process-deposit TXID
  process-redemption WITHDRAWAL_ADDRESS
  cancel-redemption WITHDRAWAL_ADDRESS
  process-redemptions        Process at most one queued withdrawal
  recover-redemptions [--once]
  recover-cancellations
  reconcile-reserve
Build first: cargo build --release -p wgrc-relayer
Service scan batch: WGRC_GRIDCOIN_BATCH_SIZE (default 50; range 1-10000)
HELP
  exit 0
fi
# Reject invalid user arguments before prompting for RPC credentials.
case "$1" in
  status)
    if (( $# != 1 )); then echo "Usage: wgrc $1" >&2; exit 1; fi ;;
  supply)
    pending_deposits=false
    pending_payouts=false
    for option in "${@:2}"; do
      case "$option" in
        --pending-deposits) if "$pending_deposits"; then exit 1; fi; pending_deposits=true ;;
        --pending-payouts) if "$pending_payouts"; then exit 1; fi; pending_payouts=true ;;
        *) echo 'Usage: wgrc supply [--pending-deposits] [--pending-payouts]' >&2; exit 1 ;;
      esac
    done
    if "$pending_payouts" && [[ ! -x "${WGRC_RELAYER_BIN:-$root/target/release/wgrc-relayer}" ]]; then
      echo 'Build the relayer first: cargo build --release -p wgrc-relayer' >&2; exit 1
    fi
    if (( $# > 1 )); then
      if [[ -z ${GRC_RPC_PASSWORD:-} && ! -t 0 ]]; then
        echo 'Set GRC_RPC_PASSWORD for reserve-wallet inspection.' >&2; exit 1
      fi
      source "$root/bin/deposit-common.sh"
      export WGRC_TESTNET_RESERVE_ADDRESS="$reserve"
    fi ;;
  withdraw)
    if (( $# != 4 && $# != 6 )) || [[ "$3" != --gridcoin-address ]] ||
       { (( $# == 6 )) && [[ "$5" != --nonce ]]; }; then
      echo 'Usage: wgrc withdraw AMOUNT_WGRC --gridcoin-address ADDRESS [--nonce NONCE]' >&2
      exit 1
    fi ;;
esac
case "$1" in
  withdraw|deposit|broadcast-deposit|serve|watch-gridcoin|process-deposit|process-redemption|process-redemptions|recover-redemptions|reconcile-reserve)
    if [[ -z ${GRC_RPC_PASSWORD:-} && ! -t 0 ]]; then
      echo 'Set GRC_RPC_PASSWORD for noninteractive operation.' >&2
      exit 1
    fi
    source "$root/bin/deposit-common.sh"
    export WGRC_TESTNET_RESERVE_ADDRESS="$reserve"
    ;;
  status|supply|watch-solana|cancel-redemption|recover-cancellations) ;;
  *) echo 'Unknown command. Run bash bin/wgrc --help.' >&2; exit 1 ;;
esac
export ANCHOR_PROVIDER_URL="${ANCHOR_PROVIDER_URL:-https://api.devnet.solana.com}"
export ANCHOR_WALLET="${ANCHOR_WALLET:-$HOME/.config/solana/devnet.json}"
cd -- "$root"
case "$1" in
  status) exec node scripts/bridge-status.cjs ;;
  supply) shift; exec node scripts/supply.cjs "$@" ;;
  withdraw)
    if [[ "$4" == "$reserve" ]]; then
      echo 'Use a Gridcoin Testnet payout address outside the bridge reserve.' >&2; exit 1
    fi
    if (( $# == 6 )); then
      exec node scripts/request-devnet-withdrawal.cjs "$4" "$2" --nonce "$6"
    fi
    exec node scripts/request-devnet-withdrawal.cjs "$4" "$2" ;;
esac
if [[ "$1" == deposit ]]; then
  shift
  exec node scripts/client-deposit.cjs "$@"
fi
if [[ "$1" == broadcast-deposit ]]; then
  if (( $# != 2 )); then
    echo 'Usage: wgrc broadcast-deposit DEPOSIT_JSON_FILE' >&2
    exit 1
  fi
  exec node scripts/gridcoin-deposit.cjs broadcast "$reserve" "$2"
fi
export WGRC_RELAYER_BIN="${WGRC_RELAYER_BIN:-$root/target/release/wgrc-relayer}"
if [[ ! -x "$WGRC_RELAYER_BIN" ]]; then
  echo 'Relayer binary missing. Run cargo build --release -p wgrc-relayer.' >&2
  exit 1
fi
if [[ "$1" == serve ]]; then
  shift
  exec node relayer/service.cjs "$@"
fi
exec "$WGRC_RELAYER_BIN" "$@"
