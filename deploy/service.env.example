# Copy outside the repository to ~/.config/wgrc-bridge/service.env; chmod 600.
# systemd does not load your interactive shell's PATH. Adjust for your Node install.
PATH=/usr/local/bin:/usr/bin:/bin
GRC_RPC_URL=http://gridtestnet:25715
GRC_RPC_USER=dangermouse
GRC_RPC_PASSWORD=REPLACE_ME
ANCHOR_PROVIDER_URL=https://api.devnet.solana.com
ANCHOR_WALLET=/home/dm/.config/solana/devnet.json
WGRC_WORKER_TIMEOUT_SECONDS=120
